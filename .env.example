# Optional local defaults. Never commit a populated .env.
PORT=8840
HOST=127.0.0.1
GEMINI_API_KEY=
OPENAI_API_KEY=
ANALYSIS_PROVIDER=
TRANSCRIPTION_PROVIDER=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING=low
GEMINI_TRANSCRIPTION_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4.1
TRANSCRIPTION_MODEL=gpt-4o-transcribe
TRANSCRIPTION_LANGUAGE=en
# Optional independent role model IDs; the UI can also change these.
ASSESSMENT_MODEL=
PLAN_MODEL=
ANSWER_MODEL=
# Required for public hosting; see docs/hosting.md. Do not set for normal local use.
PUBLIC_ORIGIN=
ACCESS_PASSWORD=
# Optional trusted local executable implementing docs/adapter.md.
CLINICAL_ADAPTER=
