{
  "name": "clinical-live-workspace",
  "version": "0.4.1",
  "private": true,
  "description": "A voice-driven clinical workspace with live differential, assessment and management views",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:release": "node scripts/release-check.mjs",
    "bundle": "node scripts/bundle.mjs"
  },
  "dependencies": {
    "@ricky0123/vad-web": "0.0.31",
    "onnxruntime-web": "1.22.0",
    "ws": "8.21.3"
  },
  "files": [
    "public/",
    "lib/",
    "server.mjs",
    "scripts/",
    "tests/",
    "docs/",
    ".env.example",
    "LICENSE",
    "README.md",
    "package-lock.json"
  ]
}
